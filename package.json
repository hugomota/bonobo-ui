{
  "name": "bonobo-ui",
  "version": "0.1.0",
  "private": true,
  "description": "React components inspired by the look of Bonobo Labs' apps (Timepage, Actions, Flow). Not affiliated with Bonobo.",
  "type": "module",
  "main": "./dist/bonobo-ui.js",
  "module": "./dist/bonobo-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/bonobo-ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "files": [
    "dist",
    "src",
    "tailwind-preset.js"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:lib && npm run build:demo && npm run build:storybook",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --mode lib",
    "build:demo": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build:storybook": "storybook build -o storybook-static --quiet"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.2.8"
  }
}
